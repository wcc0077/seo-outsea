{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": "Individual product with specifications and images"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "required": true,
      "targetField": "name"
    },
    "description": {
      "type": "richtext",
      "required": true
    },
    "specs": {
      "type": "component",
      "repeatable": true,
      "component": "shared.spec-item"
    },
    "images": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["images"]
    },
    "imageUrl": {
      "type": "string"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product-category.product-category"
    },
    "rfidFrequency": {
      "type": "enumeration",
      "enum": ["uhf", "hf", "lf-125khz", "lf-134khz", "vhf"]
    },
    "features": {
      "type": "json"
    },
    "connectivity": {
      "type": "json"
    },
    "os": {
      "type": "enumeration",
      "enum": ["android", "windows", "other"]
    },
    "tags": {
      "type": "component",
      "repeatable": true,
      "component": "shared.tag-item"
    },
    "seoTitle": {
      "type": "string"
    },
    "seoDescription": {
      "type": "text"
    },
    "seoKeywords": {
      "type": "text"
    }
  }
}
