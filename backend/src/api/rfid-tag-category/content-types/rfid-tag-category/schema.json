{
  "kind": "collectionType",
  "collectionName": "rfid_tag_categories",
  "info": {
    "singularName": "rfid-tag-category",
    "pluralName": "rfid-tag-categories",
    "displayName": "RFID Tag Category",
    "description": "RFID tag category for organizing electronic tag products"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "required": true,
      "targetField": "name"
    },
    "description": {
      "type": "richtext"
    },
    "parent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::rfid-tag-category.rfid-tag-category",
      "inversedBy": "children"
    },
    "children": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::rfid-tag-category.rfid-tag-category",
      "mappedBy": "parent"
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    }
  }
}
